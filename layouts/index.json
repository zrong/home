{{- $pages := .Site.RegularPages -}}
[
  {{- range $i, $p := $pages -}}
  {{- if $i }},{{ end -}}
  {
    "slug":        {{ $p.File.ContentBaseName | jsonify }},
    "url":         {{ $p.Permalink | jsonify }},
    "date":        {{ $p.Date.Format "2006-01-02" | jsonify }},
    "lastmod":     {{ $p.Lastmod.Format "2006-01-02T15:04:05Z07:00" | jsonify }},
    "title":       {{ $p.Title | jsonify }},
    "description": {{ $p.Description | jsonify }},
    "categories":  [],
    "tags":        [],
    "content":     {{ $p.Plain | jsonify }}
  }
  {{- end -}}
]
